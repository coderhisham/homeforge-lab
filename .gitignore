# homelab-forge — never commit secrets or runtime state

# Per-module secrets (generated by lib/secrets.sh) — CRITICAL
.env
**/.env
!**/.env.example

# User config (may contain authkeys, tokens)
forge.config.yaml

# Runtime state
.forge/
*.state

# Restic / backup scratch
*.restic-cache/
restore-scratch/

# SSH config backups accidentally copied into repo
sshd_config.bak.*

# OS / editor cruft
.DS_Store
*.swp
*~

# Local tooling / editor config (machine-specific)
.claude/

# modules/qdrant/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# The API key is generated on first run and shown once. Every request to Qdrant
# must send it as the `api-key` header.

# Strong random API key (auto-generated, shown once on first install).
QDRANT_API_KEY=__GEN:alnum:48__

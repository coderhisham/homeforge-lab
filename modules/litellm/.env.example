# modules/litellm/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# The master key is auto-generated on first run and shown once. Provider keys
# are optional — set them only if you enable those providers in config.yaml.

# Gateway master key. Clients send this as their API key (Authorization: Bearer).
LITELLM_MASTER_KEY=__GEN:alnum:48__

# Optional external provider credentials. Leave empty unless used in config.yaml.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

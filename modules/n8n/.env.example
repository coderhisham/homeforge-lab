# modules/n8n/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Two kinds of values here:
#   - N8N_ENCRYPTION_KEY is generated ONCE by lib/env.sh and shown once. It
#     encrypts stored credentials — losing/changing it makes them unreadable.
#   - N8N_DB_PASSWORD / N8N_REDIS_PASSWORD are left EMPTY on purpose: they must
#     MATCH the passwords Postgres/Redis already generated, so modules/n8n/
#     setup.sh fills them from those modules' .env before n8n starts. Do not put
#     __GEN__ here — that would create a mismatched random value.

# Credential encryption key (generated once, shown once — BACK IT UP).
N8N_ENCRYPTION_KEY=__GEN:alnum:48__

# Postgres wiring (password filled by setup.sh from modules/postgres/.env).
N8N_DB_NAME=n8n
N8N_DB_USER=forge
N8N_DB_PASSWORD=

# Redis wiring (password filled by setup.sh from modules/redis/.env).
N8N_REDIS_PASSWORD=

# Web / proxy (set N8N_HOST + N8N_WEBHOOK_URL to your Caddy *.ts.net name).
N8N_HOST=localhost
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=
N8N_TIMEZONE=UTC

# modules/portainer/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Portainer's admin password is set via its first-run web setup screen (over
# Tailscale), not through this file — so there is no secret to generate here.
# The file exists for consistency and future tunables.

# The MagicDNS name Caddy will proxy Portainer at (e.g. portainer.<host>.ts.net).
# Informational for now; the Caddy site block wiring lands with add/remove.
TUNINFORGE_PORTAINER_HOSTNAME=

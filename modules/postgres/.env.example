# modules/postgres/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# The password uses a __GEN__ placeholder: lib/env.sh generates a strong random
# value on first run, writes it to .env (0600), and shows it once. Re-running
# never rotates it.

# Superuser role name.
POSTGRES_USER=tuninforge

# Strong random password (auto-generated, shown once on first install).
POSTGRES_PASSWORD=__GEN:alnum:40__

# Default database created for the superuser.
POSTGRES_DB=tuninforge

# Comma-separated ADDITIONAL databases to create on first boot. Each gets an
# owner role of the same name with the same password as POSTGRES_PASSWORD.
# Dependent services set these (e.g. n8n needs its own db). Leave empty for none.
# Example: POSTGRES_MULTIPLE_DATABASES=n8n,litellm
POSTGRES_MULTIPLE_DATABASES=

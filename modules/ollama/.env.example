# modules/ollama/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Ollama has no built-in authentication. Its security in tuninforge comes
# from network isolation (internal network + Caddy/Tailscale in front), NOT from
# a secret here. Do not expose it publicly without an auth layer.
#
# No secrets to generate; this file exists for consistency and future tunables.

# Optional: a model to pull automatically after first start (e.g. llama3.2).
# Leave empty to pull models yourself later with `ollama pull <model>`. Models
# are large (4-40GB) — see docs/ollama.md before enabling on a small disk.
OLLAMA_DEFAULT_MODEL=

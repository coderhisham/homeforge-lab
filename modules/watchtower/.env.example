# modules/watchtower/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# No secrets. Tunables only.

# Poll interval in seconds between update checks (default: 86400 = daily).
WATCHTOWER_POLL_INTERVAL=86400

# Optional shoutrrr notification URL for update reports (email/Slack/Telegram/…).
# Empty = no notifications. See https://containrrr.dev/shoutrrr/ for formats.
WATCHTOWER_NOTIFICATION_URL=

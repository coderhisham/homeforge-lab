# modules/minio/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Root credentials are generated on first run and shown once. The username is a
# readable fixed value; the password is a strong random secret.

# MinIO root (admin) user.
MINIO_ROOT_USER=tuninforgeadmin

# Strong random root password (auto-generated, shown once on first install).
MINIO_ROOT_PASSWORD=__GEN:alnum:40__

# Browser-facing console URL, e.g. https://minio.<host>.ts.net. Used so console
# redirects work behind Caddy. Filled when the Caddy site block is wired; leave
# empty to access via the internal network / direct.
MINIO_CONSOLE_URL=

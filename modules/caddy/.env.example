# modules/caddy/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Caddy itself needs no secrets for the Tailscale-TLS path, but we keep an
# .env for consistency and for the admin API bind. Values here are plain
# defaults; __GEN:...__ placeholders (if any) are auto-filled with secrets.

# The box's MagicDNS name, e.g. myhost.tailnet-1234.ts.net.
# tuninforge.sh auto-detects this from `tailscale status` and exports it; you can
# also set it explicitly here to override.
TUNINFORGE_TS_HOSTNAME=

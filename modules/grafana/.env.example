# modules/grafana/.env.example — copied to .env by lib/env.sh (git-ignored).
#
# Admin password is auto-generated once and shown once. Change it in the UI
# afterward if you like; this value seeds the initial admin account.

# Admin login user.
GRAFANA_ADMIN_USER=admin

# Strong random admin password (auto-generated, shown once on first install).
GRAFANA_ADMIN_PASSWORD=__GEN:alnum:32__

# Public root URL behind Caddy, e.g. https://grafana.<host>.ts.net. Needed for
# correct links/redirects when fronted by Caddy. Empty is fine for internal use.
GRAFANA_ROOT_URL=
